# Voice Assistant Configuration Example
# Copy this file to config.yaml and fill in your actual values

# Audio Configuration
audio:
  device: "ac108"  # ALSA device name for ReSpeaker 4-Mic Array
  sample_rate: 16000  # Hz
  channels: 1  # Use mono (AC108 supports this and works perfectly with openWakeWord)
  chunk_size: 1280  # Samples per chunk (80ms at 16kHz - required by openWakeWord)

# Hotword Detection Configuration
hotword:
  model: "alexa"  # Wake word model
  threshold: 0.5  # Detection threshold (0.0-1.0)
  # Lower threshold = more sensitive (more false positives)
  # Higher threshold = less sensitive (more false negatives)

# Voice Activity Detection (VAD) Configuration
vad:
  aggressiveness: 3  # VAD aggressiveness level (0-3)
  # 0 = least aggressive (detects any sound)
  # 3 = most aggressive (only clear speech)
  # Recommended: 3 to avoid false triggers from taps/movements

  speech_threshold: 3  # Consecutive speech frames required (filters brief noises)
  # Higher = more strict (ignores short sounds like taps)
  # Lower = more sensitive (may trigger on brief noises)

  silence_threshold: 15  # Silent frames before voice considered stopped
  # ~1 second at 80ms per chunk
  # Higher = waits longer before stopping

# ZMQ Audio Broadcasting Configuration
broadcaster:
  enabled: true  # Broadcast audio + events over ZeroMQ
  pub_endpoint: "tcp://*:5555"   # Outgoing: audio frames + events
  pull_endpoint: "tcp://*:5556"  # Incoming: LED commands from external consumers
  meta_interval: 30  # Seconds between stream metadata messages

# Music Configuration (mpv subprocess + duck policy)
#
# voice-assistant owns the mpv subprocess. The socket below is private —
# nothing else should connect to it. External callers (the music MCP
# server, future on-device tools) drive playback through the ZMQ
# command channel (broadcaster.pull_endpoint), not by talking to mpv
# directly.
#
# Ducking is a *reflex*: hotword + speaker activity duck the music
# automatically, no agent involvement. See `music.duck.*` below.
music:
  default_volume: 80          # 0..100. Initial volume; restored on unduck.
  mpv:
    socket: "/tmp/voice-assistant-mpv.sock"
    extra_args:               # passed verbatim to mpv
      - "--ao=coreaudio"      # macOS dev box; use --ao=pulse on Pi
      # - "--audio-device=alsa/default:CARD=Headphones"
  duck:
    target_volume: 20         # volume to duck *to*
    fade_in_ms: 200           # fade-down on duck
    fade_out_ms: 400          # fade-up on unduck
    session_timeout_s: 30.0   # failsafe: force-release the "session" duck reason
                              # after this much dead air. Refreshed by every event
                              # (voice activity, speaking, transcription, hotword)
                              # so it cannot fire mid-conversation. ConversationManager
                              # will release deterministically once it lands.

# Conversation Manager Configuration
#
# ConversationManager owns the assistant's per-turn lifecycle and
# rotates a `thread_id` across consecutive turns so an LLM
# checkpointer can thread memory through. The session_timeout_s knob
# below decides "what counts as the same conversation".
conversation:
  session_timeout_s: 300.0    # while the manager is idle, the next hotword received
                              # within this window reuses the existing thread_id; past
                              # it a fresh thread is minted (ConversationStartedEvent
                              # fires). The sweep thread also emits ConversationEndedEvent
                              # after this much idle time so DuckController & future
                              # analytics subscribers know the conversation is truly over.
                              # Refreshed by every event during a turn — never fires
                              # mid-conversation.

# Agent (LLM ReplyEngine) Configuration
#
# The agent is a deepagents (LangGraph) instance backing
# `AgentReplyEngine`. ConversationManager hands it the user's
# transcript; it returns the spoken reply. Local tools drive
# voice-assistant's mpv directly; MCP tools (over HTTP) provide
# search / library lookup against the alt-alexa-music-mcp server.
#
# Memory: in-process LangGraph InMemorySaver, keyed by `thread_id`
# from ConversationManager. Survives across turns within a process;
# lost on restart. SQLite-backed memory is on the roadmap.
agent:
  model: "openai:gpt-4o-mini"   # `<provider>:<model>` for langchain init_chat_model.
                                # Requires OPENAI_API_KEY (or the provider's equivalent)
                                # in the environment. Common alternatives:
                                #   "openai:gpt-4o"           - higher quality
                                #   "anthropic:claude-3-5-sonnet"
  system_prompt: null           # Optional override for the built-in voice-first prompt
                                # (concise, no markdown, conversational). Multi-line
                                # YAML strings are fine. null → use the package default.
  mcp:
    music:
      url: null                 # Streamable-HTTP URL of the music MCP server.
                                # Example: "http://localhost:8765/mcp"
                                # null → agent runs without library search; the
                                # local play/pause/stop tools still work but the
                                # agent can't resolve song names to URLs.
      timeout_s: 30.0           # HTTP timeout for MCP requests.
      headers: null             # Optional dict of HTTP headers for auth, e.g.
                                #   headers:
                                #     Authorization: "Bearer ${MUSIC_MCP_TOKEN}"

# Speaker (audio playback) Configuration
speaker:
  device: null   # Substring of the PyAudio output device name; null = system default.
  # Example values:
  #   "respeaker"  - on a Pi with the ReSpeaker board
  #   "USB Audio"  - generic USB DAC
  # Non-matching names fall back to the system default with a WARNING.
  channels: 1   # 1 = mono, 2 = stereo

# TTS (Text-to-Speech) Configuration
#
# Same shape as the STT block: `engine:` selects a sub-block, and only
# that sub-block's keys are read. Each sub-block's keys map 1:1 to the
# engine class's __init__ signature, so a typo'd YAML key surfaces as
# `TypeError: unexpected keyword argument` at startup — fail loud.
tts:
  engine: "piper"               # "piper" (local) | "openai" (cloud)

  # Local engine: piper-tts. Voices are downloaded on first use into
  # `cache_dir` (or the default user cache). The engine's prepare()
  # step handles ensure-voice + load.
  piper:
    model: "en_US-ryan-high"    # Piper voice name. The engine will
                                # auto-download on first prepare(); use
                                # `voice-assistant download-tts-voice -v <name>`
                                # to pre-fetch manually.
    cache_dir: null             # null = ~/.local/share/voice-assistant/piper-voices
    use_cuda: false             # GPU inference if true; CPU otherwise.

  # Cloud engine: OpenAI audio.speech API. Streams 24 kHz mono PCM16
  # via response_format="pcm" so SpeakerManager can play directly with
  # no decoder dependency.
  openai:
    model: "gpt-4o-mini-tts"    # tts-1 / tts-1-hd / gpt-4o-mini-tts
    voice: "ash"                # alloy/ash/ballad/coral/echo/fable/nova/onyx/sage/shimmer/verse
    speed: 1.0                  # 0.25 .. 4.0
    instructions: null          # Tone/style hint (gpt-4o-mini-tts only;
                                # silently ignored on tts-1*).
    timeout: 15.0               # Per-request timeout in seconds.
    api_key: null               # null = falls back to top-level openai.api_key / OPENAI_API_KEY
    base_url: null              # null = OpenAI default; set for OpenAI-compatible proxies.
    chunk_size: 4096            # Bytes per iter_bytes() read while streaming.

# STT (Speech-to-Text) Configuration
#
# Two layers:
#   * Engine-agnostic knobs (`min_audio_duration`, `max_audio_duration`)
#     configure the Transcriber's recording state machine, not the engine.
#   * Engine-specific params live under `stt.<engine>.*`. Only the
#     sub-block matching `engine:` is read; the other sub-blocks sit
#     alongside so toggling engines is a single-line change at the top.
#
# Each sub-block's keys map 1:1 to the engine class's __init__ signature.
# A typo'd key surfaces as `TypeError: unexpected keyword argument` at
# startup — fail loud, not silent.
stt:
  engine: "faster-whisper"      # "faster-whisper" (local) | "openai" (cloud)

  # Engine-agnostic
  min_audio_duration: 0.3       # Drop utterances shorter than this — Whisper hallucinates
                                # on tiny clips ("Thanks for watching!" is the canonical case)
  max_audio_duration: 30.0      # Hard cap on a single recording (seconds)

  # Local engine: faster-whisper (CTranslate2-backed, runs on-device).
  faster-whisper:
    model: "tiny.en"            # tiny / tiny.en / base / base.en / small / small.en / ...
                                # `.en` variants are English-only, smaller, slightly faster.
                                # Multilingual variants (no `.en`) handle code-switched
                                # speech (e.g. en/hi). First use downloads from
                                # HuggingFace (~75 MB for tiny.en, ~145 MB for base).
    compute_type: "int8"        # int8 (Pi-friendly) | int8_float16 | float32 (max accuracy)
    language: "en"              # ISO code, or null to auto-detect each utterance
    beam_size: 1                # 1 (greedy) recommended on Pi; 5 doubles inference time
    cpu_threads: 4              # Pi 4B has 4 cores. 0 ("auto") sometimes resolves to 1 or 2
                                # in CTranslate2 ARM builds — pin it to remove the variance.
    cache_dir: null             # Where model weights live; null = HuggingFace default cache

  # Cloud engine: OpenAI audio.transcriptions API.
  # `gpt-4o-mini-transcribe` is usually the right default — half the
  # price of whisper-1, comparable accuracy, often lower latency.
  openai:
    model: "gpt-4o-mini-transcribe"   # whisper-1 / gpt-4o-transcribe / gpt-4o-mini-transcribe
    language: null              # ISO code, or null to auto-detect (recommended for hi/en mix)
    prompt: null                # Optional priming text to bias the decoder
    timeout: 15.0               # Per-request timeout in seconds
    api_key: null               # null = fall back to top-level openai.api_key / OPENAI_API_KEY env
    base_url: null              # null = OpenAI default; set for OpenAI-compatible proxies

# Logging Configuration
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
